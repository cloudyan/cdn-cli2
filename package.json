{
  "name": "@deepjs/cdn-cli",
  "version": "2.0.1",
  "description": "上传资源或部署站点到 cdn",
  "type": "module",
  "main": "./bin/index.js",
  "module": "./bin/index.js",
  "bin": {
    "cdn-cli": "./bin/index.js",
    "cdn": "./bin/index.js"
  },
  "files": [
    "bin",
    "lib",
    "src",
    "templates"
  ],
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "build": "tsc",
    "test": "npx cdn-cli deploy ./examples/dist ./cdn/dist"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "keywords": [
    "cdn"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "ali-oss": "6.22.0",
    "chalk": "5.0.0",
    "co": "4",
    "commander": "8.3.0",
    "cos-nodejs-sdk-v5": "2.14.6",
    "dir-glob": "3.0.1",
    "download": "8.0.0",
    "fs-extra": "10.0.0",
    "glob": "7.2.0",
    "handlebars": "4.7.7",
    "inquirer": "8.2.0",
    "lodash-es": "4.17.21",
    "log-symbols": "5.1.0",
    "ora": "6.0.1",
    "qiniu": "7.4.0",
    "update-notifier": "5.1.0"
  },
  "engines": {
    "node": ">=14.0.0"
  },
  "devDependencies": {
    "@types/node": "22.13.10",
    "typescript": "5.8.2"
  }
